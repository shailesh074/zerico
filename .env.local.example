# ---------------------------------------------------------------------------
# Supabase — copy this file to `.env.local` and fill in the values.
# Create a project at https://supabase.com/dashboard, then find these under
# Project Settings → API. Restart `npm run dev` after editing.
#
# The app runs fine WITHOUT these (the Supabase layer stays inert). Fill them
# in when you're ready to connect the backend.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser (governed by RLS).
NEXT_PUBLIC_SUPABASE_URL=
# New key format (Project Settings → API keys → Publishable key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET — server-only. Bypasses RLS. NEVER expose to the client or commit it.
# New key format = the "Secret key" (sb_secret_…). Needed only for admin actions
# (create business / provision owners). Also add this in Vercel → Settings → Env.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL = https://ithzkajgqkxnegcrswou.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY = sb_publishable_3axhh6IQAuW8a3CfO87CJw_unx3jm-l
sb_secret_VA9WnJ46R2DY-obRtZbyUg_qw4nwiFT
